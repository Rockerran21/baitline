# --- Networking ---
PORT=8787
# The decoy vault URL. Decoy links are built from this. In production this is your
# decoy domain, e.g. https://custody.example
PUBLIC_URL=http://localhost:8787
# The control plane (sign-up, setup, dashboard, client API). In production use a
# DIFFERENT hostname from PUBLIC_URL so someone who lands on the decoy vault cannot
# find the product. Defaults to PUBLIC_URL when unset (fine for local dev).
#CONTROL_URL=https://app.baitline.example

# --- Storage ---
DB_PATH=data/baitline.db

# --- Sign-in ---
# Sessions are short on purpose: the admin's laptop can be robbed too.
SESSION_IDLE_MS=3600000
SESSION_MAX_MS=43200000
# Adding members, changing settings, deleting: needs a sign-in newer than this.
FRESH_MS=600000
MAGIC_LINK_MS=900000
# Passkeys bind to the CONTROL_URL hostname and origin. Change CONTROL_URL and existing passkeys stop working.

# --- Behind a proxy? ---
# Only set this when a reverse proxy in front of the server OVERWRITES X-Forwarded-For.
# Without it, clients could pick their own address and evade per-address limits.
#TRUST_PROXY=1
# Development only. Lets organisation settings point at localhost. Never in production:
# it disables the checks that keep webhooks, OpenID issuers and LDAP servers off your
# internal network (byte-level private-address rejection and address pinning).
#ALLOW_LOCAL_URLS=1

# --- Alerts ---
# Push: users subscribe to their topic in the free ntfy app. Self-host for privacy.
NTFY_BASE=https://ntfy.sh
#SMTP_URL=smtps://user:pass@smtp.example.com:465
#ALERT_FROM=Baitline <alerts@example.com>
# Ignore the owner's own IP on the vault for this long after onboarding (ms).
ONBOARDING_GRACE_MS=900000
# Same (kind, IP) inside this window is recorded but not re-notified (ms).
ALERT_DEDUPE_MS=600000
# Hourly notification budget for high-severity trips. Trips past it are still recorded.
ALERT_HOURLY_CAP=6
# Separate, smaller budget for low and medium probes, so they can never starve a real alert.
PROBE_HOURLY_CAP=3
# A trip is only marked notified once a channel accepts it; failures are retried every
# five minutes up to this many attempts.
NOTIFY_MAX_ATTEMPTS=12
ENROLL_PER_HOUR_PER_IP=5

# --- Decoy identity (CHANGE THESE for a real deployment) ---
# The defaults are published in this repo, so an attacker could blocklist them.
# Pick your own convincing custody brand and a unique API-key prefix.
DECOY_BRAND=Meridian Vault
DECOY_COMPANY=Meridian Custody Ltd.
DECOY_KEY_PREFIX=mvk_live_
