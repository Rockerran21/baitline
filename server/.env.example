# Port to listen on
PORT=8787
# The URL the outside world uses to reach this server. Decoy URLs are built from it,
# so in production this must be the decoy domain, e.g. https://meridianvault.example
PUBLIC_URL=http://localhost:8787
# SQLite file
DB_PATH=data/baitline.db
# Push notifications: users subscribe to a topic in the ntfy app. Self-host or use ntfy.sh.
NTFY_BASE=https://ntfy.sh
# Optional: POST every alert as JSON here (Slack/Discord webhook, your own service)
#ALERT_WEBHOOK_URL=
# Optional: email alerts. Any nodemailer transport URL.
#SMTP_URL=smtps://user:pass@smtp.example.com:465
#ALERT_FROM=Baitline <alerts@example.com>
# How long after onboarding the owner's own IP is ignored on the vault pages (ms)
ONBOARDING_GRACE_MS=900000
