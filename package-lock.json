    "node_modules/@types/nodemailer": {
      "version": "6.4.24",
      "dev": true,
      "license": "MIT",
      "dependencies": {
        "@types/node": "*"
      }
    },
    "node_modules/hono": {
      "version": "4.13.7",
      "license": "MIT",
      "engines": {
        "node": ">=16.9.0"
      }
