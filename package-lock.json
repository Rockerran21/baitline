    "server": {
      "name": "@baitline/server",
      "version": "0.1.0",
      "dependencies": {
        "@hono/node-server": "^1.14.0",
        "hono": "^4.7.0",
        "nodemailer": "^10.0.9"
      },
      "devDependencies": {
        "@types/node": "^24.0.0",
        "@types/nodemailer": "^6.4.17",
        "typescript": "^5.8.0"
