{
  "name": "baitline",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "baitline",
      "version": "0.1.0",
      "workspaces": [
        "server",
        "client"
      ],
      "engines": {
        "node": ">=24"
      }
    },
    "client": {
      "name": "@baitline/client",
      "version": "0.1.0",
      "bin": {
        "baitline": "src/cli.ts"
      },
      "devDependencies": {
        "@types/node": "^24.0.0",
